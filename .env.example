# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# Required: the app throws on startup if either is missing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Analytics measurement id (optional). Leave unset locally so dev
# traffic doesn't pollute production analytics.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Service role key (Project Settings -> API -> service_role, "secret").
# Required for the "Delete my account" feature (app/api/delete-account).
# SERVER-ONLY: never prefix this with NEXT_PUBLIC_, never import it from a
# "use client" file, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI API key, used only by app/api/identify-book (the "take a picture and
# fill in the fields" flow). SERVER-ONLY: never prefix this with NEXT_PUBLIC_.
# Every photo identification is a paid API call, so the route requires a
# logged-in user and throttles per user.
OPENAI_API_KEY=sk-your-key-here

# Optional. Overrides the vision model used for identification, so a model
# rename or an upgrade doesn't need a code change.
OPENAI_MODEL=gpt-5-mini

# Optional. Max photo identifications per user per day (default 20). Lower this
# to keep spend down; raise it once you know the real per-call cost.
IDENTIFY_DAILY_LIMIT=20
