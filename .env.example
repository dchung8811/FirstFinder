# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# Required: the app throws on startup if either is missing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Analytics measurement id (optional). Leave unset locally so dev
# traffic doesn't pollute production analytics.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Service role key (Project Settings -> API -> service_role, "secret").
# Required for the "Delete my account" feature (app/api/delete-account).
# SERVER-ONLY: never prefix this with NEXT_PUBLIC_, never import it from a
# "use client" file, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI API key, used only by app/api/scan-book (Snap a picture) and
# app/api/identify-book (Research what it's worth). SERVER-ONLY: never prefix
# this with NEXT_PUBLIC_. Both are paid API calls, so both routes require a
# logged-in user and cap calls per user per day.
OPENAI_API_KEY=sk-your-key-here

# Optional. The model behind Snap a picture. It only transcribes printed text --
# no search, no valuation -- so a small vision model is enough; gpt-5.4-nano
# puts a two-photo scan near a tenth of a cent. Any model that accepts images
# and structured outputs on the Responses API works here.
OPENAI_SCAN_MODEL=gpt-5.4-nano

# Optional, and off by default: with it unset, scanning has no daily cap and
# runs for as long as the OpenAI account has credit. Set it to a whole number
# to cap scans per user per UTC day (0 switches scanning off). Enforced by
# supabase/scan-daily-limit.sql.
SCAN_DAILY_LIMIT=

# Optional. Overrides the model used for identification, so a model rename or
# an upgrade doesn't need a code change. Must be a model OpenAI supports with
# the web_search tool -- defaults to gpt-5.5, which their docs recommend for
# new web_search integrations. This costs more per call than a plain vision
# model, since it's a reasoning model plus one or more search round-trips.
OPENAI_MODEL=gpt-5.5

# Optional. Max photo identifications per user per day (default 10 -- lower
# than before the search-grounded rework, since each call now costs more).
# Lower this to keep spend down; raise it once you know the real per-call cost.
IDENTIFY_DAILY_LIMIT=20

# Optional. A GitHub personal access token with NO scopes (public read-only),
# used by app/api/contribute to list the open issues shown on the Contribute
# page. Without it the route still works -- it just shares GitHub's
# unauthenticated limit of 60 requests per hour per IP, which the route's
# 15-minute cache keeps it well under. Set this only if a shared deployment IP
# starts getting rate-limited. SERVER-ONLY: never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=

# --- Feedback to GitHub issues (app/api/feedback-intake) -------------------
# Feedback submitted in the app is filed as a GitHub issue as it arrives. No
# model is involved: the issue is the user's report, and you triage it on
# GitHub. Personal details are masked first, since the issue is public.

# GitHub token used to file those issues, and to raise the Contribute page's
# rate limit. SERVER-ONLY. This is the switch that turns filing on. Filing needs
# write access to issues on this repo: a fine-grained token scoped to this
# repository with Issues: Read and write is enough (add Projects: Read and write
# only if you set GITHUB_PROJECT_NUMBER). A classic token needs `public_repo`.
# Without it, feedback is still saved -- just not filed.
GITHUB_TOKEN=

# Optional. The number of a GitHub Project board to add newly filed issues to --
# the number in the board's URL (/users/<you>/projects/2 -> 2). Best effort: if
# it fails the issue is still created.
GITHUB_PROJECT_NUMBER=

# Optional. Set to false to stop filing issues on submit. Feedback is still
# saved to the feedback table either way.
FEEDBACK_AUTO_FILE=

# Optional. Most submissions one user can have filed in a rolling 24 hours
# (default 5). Past this their feedback is saved but not filed -- the backstop
# against one person spraying issues into a public tracker.
FEEDBACK_AUTO_FILE_DAILY_LIMIT=

# --- Admin dashboard (/admin) ----------------------------------------------
# Comma-separated Supabase user ids allowed to read platform-wide metrics.
# Unset means nobody is an admin and the dashboard returns 401 to everyone,
# which is the right default for a fork and the right default for a variable
# that grants access to every account's aggregate data.
#
# Ids, not email addresses: an account holder can change their own email
# through Supabase's flows, so an allowlist keyed on email can be joined by
# anyone who sets their address to a string listed here. Find yours with
#   select id, email from auth.users where email = 'you@example.com';
#
# This list does double duty. It is the access gate, and it is also the set of
# accounts excluded from the headline figures -- the maintainer's own
# collection dominates a young platform, so the dashboard leads with the
# numbers minus these accounts and shows the true total beside them.
ADMIN_USER_IDS=

# Optional. Which Supabase plan this project is on: free (default) or pro.
# Only decides which allowances the limit checks are measured against -- the
# free-tier numbers are wrong on Pro, so quoting them there would be
# confidently misleading. Update it in the same change that upgrades the plan.
SUPABASE_PLAN=free
