# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# Required: the app throws on startup if either is missing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Analytics measurement id (optional). Leave unset locally so dev
# traffic doesn't pollute production analytics.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
