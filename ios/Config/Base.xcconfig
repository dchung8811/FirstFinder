// Settings shared by every configuration. The Supabase values live in
// Secrets.xcconfig, which is gitignored; the optional include keeps a fresh
// clone building (in Sample mode) before anyone has created it.
#include? "Secrets.xcconfig"

// Where Explore, /c/<slug>, the book guides and the public JSON routes are read
// from. The prototype never talks to a local Next server: the dashboard check
// compares against :3000, but the phone reads the same live database either way.
FIRSTFINDER_SITE_URL = https:/$()/firstfinder.app

// Sign in with Apple, off until it can work: it needs a paid Apple Developer
// team, the Sign in with Apple capability on the app ID, and the Apple
// provider turned on in Supabase with this bundle ID as an authorized client.
// Until then the button says it isn't available rather than failing in
// Apple's sheet. Set to YES once all three exist (docs/ios-launch-plan.md).
APPLE_SIGN_IN = NO
