// Copy this file to Secrets.xcconfig (same folder) and fill in the two values
// from NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY in .env.local.
//
// xcconfig treats "//" as the start of a comment, so a pasted URL is cut off
// at "https:". Write it with "$()" between the slashes, exactly as below; the
// app refuses to start Live mode if it sees the cut-off form.
//
// The anon (public) key only. The app checks the key it is given and refuses
// one with any other role, and the test suite fails if one appears in ios/.

SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here

// Optional: your Apple signing team ID, to run the app on your own iPhone
// (Xcode → Settings → Accounts shows it). Kept here rather than in the project
// because each contributor signs with their own. Leave it out for the
// simulator. If Xcode's Signing tab writes a team into the project file
// instead, move it back here before committing.
// DEVELOPMENT_TEAM = ABCDE12345

// Optional, and needed with DEVELOPMENT_TEAM: a bundle ID of your own, since
// app.firstfinder belongs to the project's App Store team. Email sign-in links
// return to <this>://auth-callback, so add that address to your Supabase
// project's Redirect URLs.
// FF_BUNDLE_ID = app.firstfinder.yourname
// On a free personal team, also leave out Sign in with Apple, which only a
// paid team can sign:
// FF_ENTITLEMENTS =
// APPLE_SIGN_IN = NO
